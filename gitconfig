[filter "lfs"]
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
clean = git-lfs clean -- %f

[credential]
helper = manager-core

[user]
name = Kenneth M. DeTullio
email = detullio@gmail.com

[core]
excludesFile = ~/.gitignore
editor = emacs -nw -q

[color]
ui = auto

[color "branch"]
current = yellow reverse
local = yellow
remote = green

[color "diff"]
meta = black
frag = yellow
old = cyan
new = green

[color "status"]
added = green
changed = white bold
untracked = white

[status]
submodulesummary = true # more submodule information during status

[submodule]
recurse = true # automatically recurse submodules for most commands (not clone, ls-files, or branch)


[diff]
tool = bc

[merge]
tool = bc

[init]
defaultBranch = unstable
